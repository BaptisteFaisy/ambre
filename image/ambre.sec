# SPDX-License-Identifier: Apache-2.0
#
# image/ambre.sec - QNX 8.0 security policy for the Ambre Event Data Recorder.
#
# Provenance: the statement forms `type`, `allow <t> self:ability {...}` and
# `allow_attach` are taken from the working policy of the sibling project
# `passerelle` (https://github.com/BaptisteFaisy/passerelle, Apache-2.0, same
# author, image/passerelle.sec). Source of the language: QNX SDP 8.0 System
# Security Guide, "Security policy language" and "Abilities Reference":
#   https://www.qnx.com/developers/docs/8.0/com.qnx.doc.security.system/topic/manual/secpol_language.html
#   https://www.qnx.com/developers/docs/8.0/com.qnx.doc.security.system/topic/manual/abilities_reference.html
#
# UNVERIFIED (needs QNX SDP 8.0): secpolcompile is the acceptance test of this
# file. The statement forms that passerelle proved (`type`, `allow self:ability`,
# `allow_attach`) are reproduced as-is; the `provides` bindings and the
# channel/device/path rules below follow the same language but could not be
# compiled here - their exact grammar (object class names, permission names)
# must be confirmed against the manual pages above before secpolcompile.
#
# Covered requirements:
#   SEC-01  One type per process; producers write the input only; the service
#           type reads only; edr-journal alone reaches the raw partition.
#   SEC-02  No ability, channel or path here could stop or disable the
#           recorder: nothing here grants process control over another type.
#   SEC-03  No type but edr_journal_t can write the raw journal, so no
#           application command can erase a locked event on the medium.
#   SEC-06  The configuration file is read-only for every type.
#   VIE-03  Closed loop: no network type is declared, no network ability is
#           granted, so no EDR process can open a network connection.
#   QNX-04  rlimit lets the critical processes raise RLIMIT_MEMLOCK (mlock).

# ---------------------------------------------------------------------------
# Types - one per process role (SEC-01)
# ---------------------------------------------------------------------------
# Naming convention, checked by scripts/check-image.sh: the type of
# AMBRE_PEER_<X> (target/port/ambre_port.h, ambre_peer_type_t) is <x>_t
# prefixed with edr_. AMBRE_PEER_UNKNOWN (99) has no type: an untyped process
# is denied everything below by default.

type edr_journal_t;      # AMBRE_PEER_JOURNAL  (1) - edr-journal
type edr_capture_t;      # AMBRE_PEER_CAPTURE  (2) - edr-capture
type edr_producer_t;     # AMBRE_PEER_PRODUCER (3) - edr-replay and any
                         # other frame producer (CAN, zenoh bridge)
type edr_service_t;      # AMBRE_PEER_SERVICE  (4) - edrctl
type edr_archive_t;      # AMBRE_PEER_ARCHIVE  (5) - edr-archive

# ---------------------------------------------------------------------------
# provides - bind each binary of the boot image to its type (SEC-01)
# ---------------------------------------------------------------------------
# UNVERIFIED (needs QNX SDP 8.0): exact `provides` grammar; the binding must
# cover both paths of each binary (the IFS copy in /proc/boot and any
# installed copy), otherwise a restarted process could come back untyped.

provides edr_journal_t  -> "/proc/boot/edr-journal";
provides edr_capture_t  -> "/proc/boot/edr-capture";
provides edr_archive_t  -> "/proc/boot/edr-archive";
provides edr_producer_t -> "/usr/bin/edr-replay";
provides edr_service_t  -> "/usr/bin/edrctl";

# ---------------------------------------------------------------------------
# Abilities - the minimum each type needs, nothing more
# ---------------------------------------------------------------------------

# edr-journal: resource manager (QNX-01) on /dev/edr/journal, raw partition
# I/O, memory lock (QNX-04), kernel trace events (OBS-03), slog2 (OBS-01).
allow edr_journal_t self:ability {
    nonroot
    pathspace
    public_channel
    rlimit
    trace
};

# edr-capture: resource manager on /dev/edr/in (ACQ-01), memory lock
# (QNX-04), kernel trace events (OBS-03).
allow edr_capture_t self:ability {
    nonroot
    pathspace
    public_channel
    rlimit
    trace
};

# Producers, service tools and the archiver are plain clients: they drop root
# and need no ability at all. In particular NO type except journal/capture
# gets pathspace or public_channel, so none of them can pose as a server.
allow edr_producer_t self:ability {
    nonroot
};

allow edr_service_t self:ability {
    nonroot
};

allow edr_archive_t self:ability {
    nonroot
};

# ---------------------------------------------------------------------------
# allow_attach - who may register which name-space path
# ---------------------------------------------------------------------------

allow_attach edr_journal_t /dev/edr/journal;
allow_attach edr_journal_t /dev/edr/status;     # OBS-02 text status endpoint
allow_attach edr_capture_t /dev/edr/in;         # ACQ-01 producer input

# No other type may attach any path: a compromised client cannot hijack
# /dev/edr/in or /dev/edr/journal (SEC-01).

# ---------------------------------------------------------------------------
# allows - the connection matrix (SEC-01, mirrors the C decision function)
# ---------------------------------------------------------------------------
# This is the kernel-side twin of ambre_port_access_allowed()
# (target/port/ambre_port_posix.c), which is unit-tested on the PC:
#
#   AMBRE_OP_WRITE_INPUT : producers -> /dev/edr/in        (capture serves it)
#   AMBRE_OP_READ_STATUS : service, archive -> journal
#   AMBRE_OP_READ_EVENTS : service, archive -> journal
#   AMBRE_OP_RAW_DISK    : journal only
#
# UNVERIFIED (needs QNX SDP 8.0): object class name `channel` and permission
# name `connect` must be confirmed against the "Security policy language"
# manual page; the intent is: only the listed source types may ConnectAttach
# to a channel created by the listed target type.

allow edr_producer_t edr_capture_t:channel { connect };   # write input only
allow edr_capture_t  edr_journal_t:channel { connect };   # trigger/continue/seal/gap
allow edr_service_t  edr_journal_t:channel { connect };   # status/list/export/verify
allow edr_archive_t  edr_journal_t:channel { connect };   # read sealed events

# Everything not listed is denied: no type may connect to a producer, the
# service type may not connect to the capture input (it is not a producer),
# and an untyped intruder process may connect to nothing at all.

# ---------------------------------------------------------------------------
# Device and file access (STO-01, STO-07, SEC-03, SEC-06)
# ---------------------------------------------------------------------------
# UNVERIFIED (needs QNX SDP 8.0): object class names `dev`, `dir`, `file` and
# the permission names must be confirmed against the manual pages; the intent
# is stated in each comment and is what scripts/check-image.sh re-checks
# statically (only edr_journal_t may appear in a raw-device rule).

# STO-01 / SEC-01 / SEC-03: the raw journal partition. edr_journal_t is the
# sole writer of the medium; no other type can open it, so no application
# command can erase or overwrite a locked event behind the journal's back.
allow edr_journal_t /dev/hd0t177:dev { read write };

# STO-07: the Power-Safe archive partition (a separate device - fs-qnx6.so
# mounts it on its own device path). The archive writes MCAP files there;
# the service type may read them (export path). No other type, and no write
# for anyone but the archive.
allow edr_archive_t /dev/hd1t177:dir { read write };
allow edr_service_t /dev/hd1t177:dir { read };

# SEC-06: the configuration is read-only inside the IFS and read-only here:
# every type may read it, none may write it.
allow edr_journal_t  /etc/ambre/config.conf:file { read };
allow edr_capture_t  /etc/ambre/config.conf:file { read };
allow edr_archive_t  /etc/ambre/config.conf:file { read };
allow edr_service_t  /etc/ambre/config.conf:file { read };
allow edr_producer_t /etc/ambre/config.conf:file { read };

# ---------------------------------------------------------------------------
# VIE-03 - closed loop, by omission
# ---------------------------------------------------------------------------
# No network type is declared and no network ability (io-sock client, socket
# creation) is granted to any type above. The boot image contains no network
# stack at all (image/ambre.build), so there is nothing to connect to: the
# recorder cannot open a network connection, and neither can anything else in
# the image. This is checked statically by scripts/check-image.sh and must be
# demonstrated on target by an intrusion test (docs/SECURITY.md §4).

# ---------------------------------------------------------------------------
# SEC-02 - nothing here can stop the recorder
# ---------------------------------------------------------------------------
# No rule above grants any type an ability over another type's processes
# (no process control, no signal, no kill class permission). Stopping
# edr-journal or edr-capture from user space therefore requires root outside
# the policy; inside the policy it is impossible. The supervision wrapper
# (image/ambre-supervise.sh, later QNX HAM) respawns any killed process and
# logs the interruption.
